{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",
  "platformAutomerge": false,

  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages\\/cockpit-upside\\/package\\.env$/",
      ],
      "matchStrings": [
        "UPSIDE_VERSION=(?<currentValue>\\S+)\\s+UPSIDE_COMMIT=(?<currentDigest>[a-f0-9]{40})",
      ],
      "packageNameTemplate": "deviationist/cockpit-upside",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages\\/superfile\\/package\\.env$/",
      ],
      "matchStrings": [
        "SUPERFILE_VERSION=(?<currentValue>\\S+)\\s+SUPERFILE_COMMIT=(?<currentDigest>[a-f0-9]{40})",
      ],
      "packageNameTemplate": "yorukot/superfile",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages\\/mergerfs\\/package\\.env$/",
      ],
      "matchStrings": [
        "MERGERFS_VERSION=(?<currentValue>\\S+)\\s+MERGERFS_COMMIT=(?<currentDigest>[a-f0-9]{40})",
      ],
      "packageNameTemplate": "trapexit/mergerfs",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages\\/glances\\/package\\.env$/",
      ],
      "matchStrings": [
        "GLANCES_VERSION=(?<currentValue>\\S+)\\s+GLANCES_COMMIT=(?<currentDigest>[a-f0-9]{40})",
      ],
      "packageNameTemplate": "nicolargo/glances",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages\\/virtui-manager\\/package\\.env$/",
      ],
      "matchStrings": [
        "VIRTUI_MANAGER_VERSION=(?<currentValue>\\S+)\\s+VIRTUI_MANAGER_COMMIT=(?<currentDigest>[a-f0-9]{40})",
      ],
      "packageNameTemplate": "aginies/virtui-manager",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages\\/nm-hsp\\/package\\.env$/",
      ],
      "matchStrings": [
        "NM_HSP_VERSION=(?<currentValue>\\S+)\\s+NM_HSP_COMMIT=(?<currentDigest>[a-f0-9]{40})",
      ],
      "packageNameTemplate": "home-server-project/nm-hsp",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$",
    },
  ],

  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
      ],
      "pinDigests": true,
      "automerge": true,
      "automergeType": "pr",
    },
    {
      "matchManagers": [
        "pep621",
      ],
      "matchDepTypes": [
        "requires-python",
      ],
      "enabled": false,
    },
    {
      "matchPackageNames": [
        "deviationist/cockpit-upside",
        "yorukot/superfile",
        "trapexit/mergerfs",
        "nicolargo/glances",
        "aginies/virtui-manager",
        "home-server-project/nm-hsp",
      ],
      "prHourlyLimit": 0,
      "automerge": true,
      "automergeType": "pr",
    },
    {
      "matchPackageNames": [
        "textual",
      ],
      "automerge": true,
      "automergeType": "pr",
    },
  ],
}
